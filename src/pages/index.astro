const hackathonFeatures = [
  'IA predictiva que anticipa lesiones hasta 72hs antes',
  'Dashboard unificado para atletas, coaches y tutores',
  'Monitoreo de sueño, nutrición y carga semanal',
  'Alertas en tiempo real y métricas de rendimiento',
  'Agenda deportiva y académica integrada',
];

const hackathonStack = ['Next.js', 'TypeScript', 'Tailwind CSS', 'Supabase', 'IA/ML', 'Vercel'];

const mockupStats = [
  { label: 'Sueño', value: '7.2h', icon: 'fas fa-moon', color: 'text-blue-400' },
  { label: 'Energía', value: '84%', icon: 'fas fa-bolt', color: 'text-yellow-400' },
  { label: 'Carga', value: '↓34%', icon: 'fas fa-heart', color: 'text-red-400' },
];

const mockupRoles = [
  { label: 'AT', color: 'bg-yellow-600' },
  { label: 'CO', color: 'bg-blue-600' },
  { label: 'TU', color: 'bg-green-600' },
];
---

<Layout title="DevHub | Agencia de Desarrollo de Software en Argentina — Landing Pages, E-commerce y Sistemas a Medida">

  <!-- ① Hero -->
  <Hero />

<!-- ② Plataformas -->
<section class="py-20 bg-dark-primary relative overflow-hidden" id="planes">
  <div class="absolute inset-0 opacity-[0.15]"
    style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 40px 40px;">
  </div>
  <div class="absolute top-0 left-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-blue-500/5 rounded-full blur-3xl translate-x-1/2 translate-y-1/2"></div>

  <div class="container mx-auto px-4 relative z-10">
    <p class="text-center text-xs uppercase tracking-widest text-gray-500 mb-2 font-mono animate-on-scroll opacity-0">// sistemas_devhub</p>
    <h2 class="text-4xl md:text-5xl font-bold text-center mb-4 animate-on-scroll opacity-0 font-display">
      Elegí tu <span class="text-primary">plataforma</span>
    </h2>
    <p class="text-center text-gray-400 mb-16 animate-on-scroll opacity-0 max-w-xl mx-auto">
      Cada plan incluye tu página web y el sistema de gestión corriendo, todo en un solo pago mensual.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      {productos.map((p, i) => (
        <div
          class={`animate-on-scroll opacity-0 group relative bg-[#0a0e14] rounded-xl border ${p.accentBorder} ${p.accentHoverBorder} ${p.accentGlowBorder} transition-all duration-500 hover:-translate-y-2 overflow-hidden font-mono`}
          style={`animation-delay: ${i * 0.12}s`}
        >
          {/* corner brackets HUD */}
          <div class={`absolute top-2 left-2 w-4 h-4 border-l-2 border-t-2 ${p.accentBorder} opacity-70`}></div>
          <div class={`absolute top-2 right-2 w-4 h-4 border-r-2 border-t-2 ${p.accentBorder} opacity-70`}></div>
          <div class={`absolute bottom-2 left-2 w-4 h-4 border-l-2 border-b-2 ${p.accentBorder} opacity-70`}></div>
          <div class={`absolute bottom-2 right-2 w-4 h-4 border-r-2 border-b-2 ${p.accentBorder} opacity-70`}></div>

          {/* fondo grid sutil por card */}
          <div class="absolute inset-0 opacity-40"
            style={`background-image: linear-gradient(${p.gridColor} 1px, transparent 1px), linear-gradient(90deg, ${p.gridColor} 1px, transparent 1px); background-size: 24px 24px;`}>
          </div>

          <div class="relative z-10">
            {/* barra tipo terminal */}
            <div class="flex items-center justify-between px-5 py-3 border-b border-white/5 bg-black/30">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-red-500/70"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/70"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-green-500/70"></span>
              </div>
              <span class="text-[10px] text-gray-500 tracking-wider">{p.slug}.devhub.com.ar</span>
            </div>

            <div class="p-6">
              <div class="flex items-center gap-3 mb-4">
                <div class={`w-40 h-12 bg-black/40 rounded-lg flex items-center justify-center border ${p.accentBorder} p-1.5`}>
                  <img src={p.logo} alt={p.nombre} class="w-full h-full object-contain" />
                </div>
                <div>
                  <h3 class="text-lg font-bold text-white font-display">{p.nombre}</h3>
                  <p class={`${p.accentText} text-[11px] uppercase tracking-wider`}>{p.tagline}</p>
                </div>
              </div>

              <div class="flex items-baseline gap-1 mb-1">
                <span class="text-gray-500 text-lg">$</span>
                <span class="text-3xl font-bold text-white">{p.price}</span>
                <span class="text-gray-500 text-xs ml-1">{p.priceNote}</span>
              </div>

              <p class="text-gray-400 text-sm mb-5 leading-relaxed font-sans">{p.desc}</p>

              {/* mini consola / mockup */}
              <div class={`rounded-lg border ${p.accentBorder} bg-black/40 p-3 mb-5 text-[11px]`}>
                {p.mockup.lines.map(([label, value]) => (
                  <div class="flex justify-between items-center py-0.5">
                    <span class="text-gray-500">$ {label}</span>
                    <span class={`${value === 'OK' ? 'text-green-400' : value === 'PEND' ? 'text-yellow-400' : p.accentText}`}>{value}</span>
                  </div>
                ))}
                {p.mockup.total && (
                  <div class="flex justify-between pt-2 mt-1 border-t border-white/10">
                    <span class="text-gray-500">TOTAL</span>
                    <span class={`font-bold ${p.accentText}`}>{p.mockup.total}</span>
                  </div>
                )}
              </div>

              <ul class="space-y-2 mb-6">
                {p.features.map(f => (
                  <li class="flex items-start gap-2 text-[13px] text-gray-300 font-sans">
                    <span class={`${p.accentText} mt-0.5`}>&gt;</span>
                    {f}
                  </li>
                ))}
              </ul>

              <div class="flex items-center gap-3">
                <a href={p.infoUrl}
                  class={`flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 border rounded-lg transition-all duration-300 text-xs uppercase tracking-wider ${p.accentBtnGhost}`}>
                  <i class="fas fa-terminal text-[10px]"></i>
                  detalles
                </a>
                <a href={p.ctaUrl} target="_blank" rel="noopener noreferrer"
                  class={`flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 text-white font-bold rounded-lg transition-all duration-300 text-xs uppercase tracking-wider ${p.accentBtn}`}>
                  <i class="fab fa-whatsapp text-xs"></i>
                  contratar
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
  <!-- ④ Servicios -->
<section class="py-20  relative overflow-hidden">
  <div class="absolute top-0 right-0 w-64 h-64 bg-primary/5 rounded-full blur-3xl"></div>
    <div class="container mx-auto px-4 relative z-10">
      <h2 class="text-4xl md:text-5xl font-bold text-center mb-4 animate-on-scroll opacity-0 font-display">
        Nuestros <span class="text-primary">Servicios</span>
      </h2>
      <p class="text-center text-gray-400 mb-16 animate-on-scroll opacity-0">
        Soluciones tecnológicas a medida para cada necesidad
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
        {services.map((service, i) => (
          <div class="animate-on-scroll opacity-0" style={`animation-delay: ${i * 0.1}s`}>
            <ServiceCard {...service} />
          </div>
        ))}
      </div>
      <div class="text-center animate-on-scroll opacity-0">
        <a href="/servicios" class="inline-flex items-center gap-2 px-8 py-4 bg-primary text-dark font-bold rounded-lg hover:bg-primary-dark transition-all duration-300 hover:scale-105">
          <i class="fas fa-arrow-right"></i>
          Ver todos los servicios con detalles
        </a>
      </div>
    </div>
  </section>

<!-- ⑤ Por qué DevHub -->
<section class="relative overflow-hidden">
  <!-- Fondo Hyperspeed, ocupa toda la sección -->
  <div class="absolute inset-0 z-0 bg-dark">
    <HyperspeedBG client:media="(min-width: 768px)" />
    <div class="md:hidden absolute inset-0 bg-dark"></div>
  </div>

  <!-- Overlay para que el texto no compita con las líneas -->
  <div class="absolute inset-0 z-[1] bg-gradient-to-b from-dark/70 via-dark/50 to-dark/80"></div>

  <div class="relative z-10 py-20 container mx-auto px-4">
    <h2 class="text-4xl md:text-5xl font-bold text-center mb-4 animate-on-scroll opacity-0 font-display">
      ¿Por qué <span class="text-primary">DevHub</span>?
    </h2>
    <p class="text-center text-gray-300 mb-16 animate-on-scroll opacity-0">La diferencia entre una plantilla y un sitio a medida</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-12">
      {[
        { icon: 'fas fa-tachometer-alt', stat: '+300%', title: 'Velocidad', desc: 'Hasta 10x más rápidos que Wix o Tienda Nube. Google premia la velocidad.' },
        { icon: 'fas fa-crown', stat: '100%', title: 'Tuyo', desc: 'El código es 100% tuyo. No dependés de plataformas que cambian precios o cierran.' },
        { icon: 'fas fa-dollar-sign', stat: '0$/mes', title: 'Sin suscripción', desc: 'Pago único vs. suscripciones mensuales eternas. En 1-2 años ya ahorraste.' },
        { icon: 'fas fa-search', stat: 'Top 10', title: 'SEO Profesional', desc: 'Optimización técnica profunda imposible con plantillas genéricas.' },
        { icon: 'fas fa-infinity', stat: '∞', title: 'Sin Límites', desc: 'Crecé sin restricciones. Sin planes premium ni funciones bloqueadas.' },
        { icon: 'fas fa-map-marker-alt', stat: 'Local', title: 'Equipo Catamarca', desc: 'Reuniones presenciales posibles. Entendemos el mercado local.' },
      ].map((item, i) => (
        <div class="group bg-dark/90 backdrop-blur-sm p-6 rounded-xl border-2 border-white/10 hover:border-primary transition-all duration-500 hover:-translate-y-2 animate-on-scroll opacity-0 relative overflow-hidden" style={`animation-delay: ${i * 0.1}s`}>
          <div class="absolute top-0 right-0 bg-primary/20 text-primary px-3 py-1 rounded-bl-lg rounded-tr-lg font-bold text-sm border border-primary/30">
            <span class="stat-number" data-count={item.stat}>0</span>
          </div>
          <div class="text-4xl mb-3 mt-3 group-hover:scale-110 transition-transform duration-300 inline-block">
            <i class={`${item.icon} text-primary`}></i>
          </div>
          <h3 class="text-lg font-bold text-primary mb-2 font-display">{item.title}</h3>
          <p class="text-gray-300 text-sm">{item.desc}</p>
        </div>
      ))}
    </div>
    <div class="text-center animate-on-scroll opacity-0">
      <a href="/servicios#ventajas" class="inline-flex items-center gap-2 text-primary font-semibold hover:underline">
        <i class="fas fa-chart-line"></i>
        Ver comparación completa vs. Wix y Tienda Nube
      </a>
    </div>
  </div>
</section>

  <!-- ⑥ Proyectos -->
  <section class="py-20 relative overflow-hidden">
    <div class="container mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-bold text-center mb-4 animate-on-scroll opacity-0 font-display">
        Proyectos <span class="text-primary">Reales</span>
      </h2>
      <p class="text-center text-gray-400 mb-16 animate-on-scroll opacity-0">Resultados concretos para negocios reales</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto mb-12">
        {projects.map((p, i) => (
          <a href={p.demoUrl} target="_blank" rel="noopener noreferrer"
            class="group bg-dark-secondary p-6 rounded-xl border-2 border-transparent hover:border-primary transition-all duration-500 hover:-translate-y-3 hover:shadow-xl hover:shadow-primary/20 animate-on-scroll opacity-0 block"
            style={`animation-delay: ${i * 0.12}s`}>
            <div class="flex items-start justify-between mb-4">
              <div class="text-4xl group-hover:scale-110 transition-transform duration-300">
                <i class={`${p.icon} text-primary`}></i>
              </div>
              <span class="text-xs px-3 py-1 bg-primary/20 text-primary rounded-full border border-primary/30">{p.category}</span>
            </div>
            <h3 class="text-xl font-bold text-primary mb-3 font-display">{p.title}</h3>
            <div class="flex flex-wrap gap-2 mb-4">
              {p.technologies.map(t => (
                <span class="text-xs px-2 py-1 bg-dark rounded-full text-gray-400 border border-dark-tertiary">{t}</span>
              ))}
            </div>
            <span class="inline-flex items-center gap-2 text-primary text-sm font-semibold group-hover:underline">
              <i class="fas fa-external-link-alt text-xs"></i>
              Ver en vivo
            </span>
          </a>
        ))}
      </div>
      <div class="text-center animate-on-scroll opacity-0">
        <a href="/proyectos" class="inline-flex items-center gap-2 px-8 py-4 border-2 border-primary text-primary font-bold rounded-lg hover:bg-primary hover:text-dark transition-all duration-300 hover:scale-105">
          <i class="fas fa-folder-open"></i>
          Ver portfolio completo
        </a>
      </div>
    </div>
  </section>

  <!-- ⑦ Blog -->
  <section class="py-20 bg-dark relative overflow-hidden">
    <div class="container mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-bold text-center mb-4 animate-on-scroll opacity-0 font-display">
        Del <span class="text-primary">Blog</span>
      </h2>
      <p class="text-center text-gray-400 mb-16 animate-on-scroll opacity-0">Recursos y guías para negocios que quieren crecer online</p>
      <div class="max-w-3xl mx-auto">
        <a href="/blog/wix-vs-desarrollo-a-medida" class="group bg-dark p-8 rounded-2xl border-2 border-transparent hover:border-primary transition-all duration-500 hover:shadow-xl hover:shadow-primary/20 block animate-on-scroll opacity-0">
          <div class="flex flex-wrap gap-3 mb-4">
            <span class="text-xs px-3 py-1 bg-primary/20 text-primary rounded-full border border-primary/30">⭐ Artículo Destacado</span>
            <span class="text-xs px-3 py-1 bg-dark-secondary text-gray-400 rounded-full border border-dark-tertiary">15 min lectura</span>
            <span class="text-xs px-3 py-1 bg-dark-secondary text-gray-400 rounded-full border border-dark-tertiary">SEO</span>
          </div>
          <h3 class="text-2xl font-bold text-primary mb-3 group-hover:underline font-display">
            ¿Wix, Tienda Nube o Desarrollo a Medida? La Guía Definitiva 2025
          </h3>
          <p class="text-gray-300 mb-4">
            Comparamos en detalle las 3 opciones para que puedas tomar la mejor decisión para tu negocio. Velocidad, SEO, costos reales y casos de uso concretos.
          </p>
          <span class="inline-flex items-center gap-2 text-primary font-semibold">
            Leer artículo completo <i class="fas fa-arrow-right"></i>
          </span>
        </a>
      </div>
      <div class="text-center mt-8 animate-on-scroll opacity-0">
        <a href="/blog" class="inline-flex items-center gap-2 text-primary font-semibold hover:underline">
          <i class="fas fa-newspaper"></i>
          Ver todos los artículos
        </a>
      </div>
    </div>
  </section>

  <!-- ⑧ CTA Final -->
  <section class="py-20  relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary/5 rounded-full blur-3xl"></div>
    <div class="container mx-auto px-4 text-center relative z-10">
      <h2 class="text-4xl md:text-6xl font-bold mb-6 animate-on-scroll opacity-0 font-display">
        ¿Listo para tener tu <span class="text-primary">sitio profesional</span>?
      </h2>
      <p class="text-xl text-gray-300 mb-10 max-w-2xl mx-auto animate-on-scroll opacity-0">
        Contanos tu idea y te respondemos en menos de 24hs con una propuesta personalizada.
      </p>
      <div class="flex flex-wrap justify-center gap-4 animate-on-scroll opacity-0">
        <a href="https://wa.me/5493834944727" target="_blank" rel="noopener noreferrer"
          class="px-10 py-5 bg-primary text-dark font-bold rounded-xl text-lg hover:bg-primary-dark transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-primary/50 flex items-center gap-3">
          <i class="fab fa-whatsapp text-xl"></i>
          Hablar por WhatsApp
        </a>
        <a href="/contacto"
          class="px-10 py-5 border-2 border-primary text-primary font-bold rounded-xl text-lg hover:bg-primary/10 transition-all duration-300 hover:scale-105 flex items-center gap-3">
          <i class="fas fa-paper-plane"></i>
          Enviar consulta
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  [data-anim], .animate-on-scroll { opacity: 0; }
  [data-anim="up"], .animate-on-scroll { transform: translateY(40px); }
  [data-anim="left"] { transform: translateX(-50px); }
  [data-anim="right"] { transform: translateX(50px); }
  [data-anim="scale"] { transform: scale(0.85); }
  [data-anim].in-view, .animate-on-scroll.in-view {
    opacity: 1;
    transform: translate(0, 0) scale(1);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .font-display .text-primary {
    background: linear-gradient(90deg, theme(colors.primary.DEFAULT), #7dd3fc, theme(colors.primary.DEFAULT));
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: gradient-shift 6s ease infinite;
  }
  @keyframes gradient-shift {
    0% { background-position: 0% center; }
    50% { background-position: 100% center; }
    100% { background-position: 0% center; }
  }

  .stat-number.counted { animation: pop 0.4s ease; }
  @keyframes pop {
    0% { transform: scale(0.8); }
    60% { transform: scale(1.15); }
    100% { transform: scale(1); }
  }
</style>

<script>
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in-view');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });

  document.querySelectorAll('[data-anim], .animate-on-scroll').forEach((el, i) => {
    (el as HTMLElement).style.transitionDelay = `${(i % 6) * 0.08}s`;
    revealObserver.observe(el);
  });

  function animateCount(el: HTMLElement) {
    const raw = el.dataset.count || '';
    const match = raw.match(/[\d.]+/);
    if (!match) { el.classList.add('counted'); return; }
    const end = parseFloat(match[0]);
    const suffix = raw.replace(match[0], '');
    const duration = 1200;
    const start = performance.now();
    function tick(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = Math.floor(end * eased);
      el.textContent = current + suffix;
      if (progress < 1) requestAnimationFrame(tick);
      else el.classList.add('counted');
    }
    requestAnimationFrame(tick);
  }

  const statObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        animateCount(entry.target as HTMLElement);
        statObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.5 });

  document.querySelectorAll('.stat-number').forEach((el) => statObserver.observe(el));
</script>
