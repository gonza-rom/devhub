  },
];

const productos = [
  {
    slug: 'pos',
    logo: '/devhub-pos.png',
    nombre: 'DevHub POS',
    tagline: 'Punto de venta',
    desc: 'Administrá ventas, stock e inventario desde cualquier dispositivo. Incluye tu página web con catálogo y botón de WhatsApp.',
    price: '50.000',
    priceNote: '/mes · landing + sistema',
    color: 'red',
    icon: 'fas fa-cash-register',
    accentText: 'text-red-400',
    accentBorder: 'border-red-500/30',
    accentBg: 'bg-red-600/20',
    accentGlowBorder: 'shadow-[0_0_25px_-5px_rgba(220,38,38,0.4)]',
    accentHoverBorder: 'hover:border-red-500/70',
    accentDot: 'bg-red-500',
    accentBtn: 'bg-red-600 hover:bg-red-500',
    accentBtnGhost: 'border-red-500/40 text-red-300 hover:bg-red-600/20 hover:border-red-500/70',
    gridColor: 'rgba(220,38,38,0.08)',
    demoUrl: 'https://pos.devhub.com.ar/',
    infoUrl: '/productos/pos',
    ctaUrl: 'https://wa.me/3834944727',
    features: [
      'Página web profesional con catálogo',
