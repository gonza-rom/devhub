    accentDot: 'bg-blue-500',
    accentBtn: 'bg-blue-600 hover:bg-blue-500',
    accentBtnGhost: 'border-blue-500/40 text-blue-300 hover:bg-blue-600/20 hover:border-blue-500/70',
    gridColor: 'rgba(37,99,235,0.08)',
    demoUrl: 'https://turnos.devhub.com.ar/',
    infoUrl: '/productos/turnos',
    ctaUrl: 'https://wa.me/3834944727',
    features: [
      'Página web con servicios y ubicación',
      'Reservas online las 24 horas',
      'Confirmación automática por WhatsApp',
      'Panel de agenda para el negocio',
      'Panel administrador',
      'Soporte y mantenimiento',
    ],
