---
interface Props {
  avatar: string;
  name: string;
  role: string;
  description: string;
  linkedinUrl: string;
  instagramUrl: string;
}

const { avatar, name, role, description, linkedinUrl, instagramUrl } = Astro.props;
---

<div class="group bg-dark-secondary p-8 rounded-xl border border-dark-tertiary hover:border-gray-500 transition-all duration-500 hover:-translate-y-2 text-center relative overflow-hidden">
  <!-- Subtle gradient overlay on hover -->
  <div class="absolute inset-0 bg-gradient-to-br from-white/5 via-transparent to-white/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

  <div class="relative z-10">
    <div class="w-28 h-28 mx-auto mb-6 bg-dark border border-dark-tertiary rounded-full flex items-center justify-center text-5xl transition-all duration-500 group-hover:scale-105 group-hover:border-white/40">
      {avatar}
    </div>

    <h3 class="text-2xl font-bold text-white mb-2 font-display">{name}</h3>

    <p class="text-gray-500 font-semibold mb-4 text-sm uppercase tracking-wide">{role}</p>

    <p class="text-gray-400 mb-6 text-sm leading-relaxed">{description}</p>

    <!-- Social Links -->
    <div class="flex items-center justify-center gap-4">
      <a
        href={linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 flex items-center justify-center rounded-full bg-dark border border-dark-tertiary text-gray-400 hover:bg-white hover:text-dark hover:border-white transition-all duration-300"
        aria-label="LinkedIn"
      >
        <i class="fab fa-linkedin-in text-lg"></i>
      </a>

      <a
        href={instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 flex items-center justify-center rounded-full bg-dark border border-dark-tertiary text-gray-400 hover:bg-white hover:text-dark hover:border-white transition-all duration-300"
        aria-label="Instagram"
      >
        <i class="fab fa-instagram text-lg"></i>
      </a>
    </div>
  </div>
</div>